{
  "name": "dsh-plugin-aomerag",
  "version": "0.1.0",
  "description": "deepseek-harness 知识库插件:AomeRAG 检索管线(chunk → embed → 混合检索)的 TypeScript 移植",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./client": "./lib/client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "test": "vitest run --project unit --project integration --passWithNoTests",
    "test:live": "vitest run --project live --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.12.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "private": true,
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1-rc.1",
    "@lancedb/lancedb": "^0.37.1",
    "better-sqlite3": "^13.0.3",
    "sqlite-vec": "^0.1.9"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-llm": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-settings": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.2",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-locale": "link:D:/GitHub/deepseek-harness/packages/client/locale",
    "@deepseek-ai/dsh-client-runtime": "link:D:/GitHub/deepseek-harness/packages/client/runtime",
    "@deepseek-ai/dsh-client-ui-settings": "link:D:/GitHub/deepseek-harness/packages/client/ui-settings",
    "@deepseek-ai/dsh-client-ui-slots": "link:D:/GitHub/deepseek-harness/packages/client/ui-slots",
    "@deepseek-ai/dsh-llm": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-settings": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-settings-file": "0.1.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.2",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.31",
    "@vitest/coverage-v8": "^4.1.11",
    "react": "^18.3.1",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "undici": "^7.29.0",
    "vitest": "^4.1.11"
  }
}
